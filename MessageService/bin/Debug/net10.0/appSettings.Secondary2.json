{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        },
        "LoggerName": "Secondary 2"
    },
    "AllowedHosts": "*",
    "Kestrel": {
        "EndpointDefaults": {
            "Protocols": "Http2"
        }
    },
    "ServiceConfig" : {
        "IsMaster": false,
        "DelayInSec": 10,
        "SelfUrl": "http://localhost:5002"
    },
    "Serilog": {
        "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "System": "Warning"
            }
        },
        "Properties": {
            "LoggerName": "Secondary 2 Service"
        },
        "WriteTo": [
            {
                "Name": "Console",
                "Args": {
                    "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
                }
            },
            {
                "Name": "File",
                "Args": {
                    "path": "logs/grpcservice_log_secondary2.txt",
                    "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{LoggerName}] {Message:lj}{NewLine}{Exception}"
                }
            }
        ],
        "AllowedHosts": "*"
    }
}
