{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "LoggerName": "Master"
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    }
  },
  "ServiceConfig" : {
    "IsMaster": true,
    "SelfUrl": "http://localhost:5000",
    "DelayInSec": 0,
    "SecondariesEndpoints": [
      "http://localhost:5001",
      "http://localhost:5002"
    ]
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Properties": {
      "LoggerName": "Master Service"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/grpcservice_log_master.txt",
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{LoggerName}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "AllowedHosts": "*"
  }
  
}
